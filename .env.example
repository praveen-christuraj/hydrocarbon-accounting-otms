# ---------------------------------------------------------------------------
# Core deployment
# ---------------------------------------------------------------------------
# Use production only behind HTTPS. Replace the example hostname with the exact
# browser URL used to open the Hydrocarbon Accounting frontend.
ENVIRONMENT=production
CORS_ORIGINS=https://hydrocarbon.example.com

# Generate each value independently and keep existing deployed JWT/encryption
# values unchanged during upgrades.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-existing-or-random-secret
ENCRYPTION_KEY=replace-with-existing-or-random-secret
SECURITY_KDF_SALT=replace-with-persistent-random-base64-value

# Required only when the database does not yet contain the bootstrap admin.
# Must satisfy the password policy (12+ characters, mixed case, digit, symbol).
INITIAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Reverse proxy / network boundary
# ---------------------------------------------------------------------------
# Comma-separated hostnames the API will answer for (Host header allowlist).
TRUSTED_HOSTS=hydrocarbon.example.com
# Only enable these when the API is reachable exclusively through the proxy.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=*
# Redirect plain HTTP to HTTPS (leave false when TLS ends upstream and the
# proxy already forwards X-Forwarded-Proto=https).
ENFORCE_HTTPS=true

# ---------------------------------------------------------------------------
# Session and cookie policy
# ---------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1
AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=.example.com
# Set false only for a documented integration that cannot use cookies.
ALLOW_REFRESH_TOKEN_IN_BODY=false

# ---------------------------------------------------------------------------
# Password lifecycle
# ---------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
DEFAULT_PASSWORD_EXPIRY_DAYS=30
# Administrator accounts are capped at 90 days and can never be set to
# "never expires".
ADMIN_PASSWORD_EXPIRY_DAYS=60
MAX_PASSWORD_EXPIRY_DAYS=365
PASSWORD_HISTORY_COUNT=5

# ---------------------------------------------------------------------------
# Lockout and throttling (per process; see DEPLOYMENT_SECURITY.md)
# ---------------------------------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
MAX_2FA_ATTEMPTS_PER_CHALLENGE=5
TWO_FA_CHALLENGE_MINUTES=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_SECONDS=300
LOGIN_IDENTITY_MAX_ATTEMPTS=10
LOGIN_IDENTITY_WINDOW_SECONDS=900
FORGOT_PASSWORD_MAX_PER_WINDOW=3
FORGOT_PASSWORD_WINDOW_SECONDS=900
SENSITIVE_ACTION_MAX_PER_WINDOW=10
SENSITIVE_ACTION_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# Request limits and diagnostics
# ---------------------------------------------------------------------------
MAX_REQUEST_BODY_BYTES=26214400
# Interactive API docs (/docs, /openapi.json) are disabled in production
# unless this is explicitly set to true. Keep unset in production.
# ENABLE_API_DOCS=false

# ---------------------------------------------------------------------------
# Database and backups
# ---------------------------------------------------------------------------
POSTGRES_USER=hydrocarbon
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=hydrocarbon_db

# Optional isolated PostgreSQL database used to validate restore files.
BACKUP_VALIDATION_DATABASE_URL=

# ---------------------------------------------------------------------------
# Production compose
# ---------------------------------------------------------------------------
PUBLIC_PORT=8080
WEB_CONCURRENCY=2
