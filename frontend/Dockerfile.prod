# Production image: compile the Vite bundle once, then serve the static files
# through nginx. The development Dockerfile runs `vite` with a bind mount and
# must never be exposed to users.
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./

# Reproducible install from the lockfile.
RUN npm ci --no-audit --no-fund

COPY . .

RUN npm run build


FROM nginx:1.27-alpine

# SPA + API reverse proxy configuration (see deploy/nginx.conf).
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

# Run unprivileged; nginx alpine ships an `nginx` user.
RUN chown -R nginx:nginx /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
